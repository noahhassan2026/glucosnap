# Copy to api/.env (git-ignored) or export these in your shell before starting the server.
# Photo -> macros with UF NaviGator AI Toolkit (create a key at https://it.ufl.edu/ai/navigator-toolkit/)
NAVIGATOR_TOOLKIT_API_KEY=
# NAVIGATOR_BASE_URL=https://api.ai.it.ufl.edu/v1
# GLUCOSNAP_VISION_MODEL=gemma-4-31b-it
# AI coach quests and meal ideas use the same key; model defaults to the vision model
# GLUCOSNAP_COACH_MODEL=gemma-4-31b-it
# Or use Claude instead (only read when NAVIGATOR_TOOLKIT_API_KEY is empty)
# ANTHROPIC_API_KEY=
# ALLOWED_ORIGINS=http://localhost:5173
